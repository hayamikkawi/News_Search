# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=ttds_app
MYSQL_PASSWORD=ttds#123
MYSQL_DATABASE=ttds_search_engine
MYSQL_POOL_SIZE=5

# Indexer Configuration
# Indexer Type: http, file, dummy
INDEXER_TYPE=http
# Base URL for HTTP Indexer
INDEXER_BASE_URL=http://localhost:8080
# HTTP timeout (seconds)
INDEXER_TIMEOUT=30
# Output directory for file-based Indexer
INDEXER_OUTPUT_DIR=./indexer_input
# Whether to save content to the database (true/false)
# false saves only metadata, content is sent only to indexer to save database storage space
SAVE_CONTENT_TO_DB=false

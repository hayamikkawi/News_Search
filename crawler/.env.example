# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=ttds_app
MYSQL_PASSWORD=ttds#123
MYSQL_DATABASE=ttds_search_engine
MYSQL_POOL_SIZE=5

# Crawler Behavior Configuration
# Maximum number of articles to fetch per RSS feed in a single run
MAX_ITEMS_PER_FEED=20
# HTTP request timeout in seconds
CRAWLER_TIMEOUT_SECONDS=15
# Sleep time between requests (seconds)
CRAWLER_SLEEP_SECONDS=1.0
# Random jitter to add to sleep time (seconds)
CRAWLER_JITTER_SECONDS=0.5
# Minimum article text length to accept (characters)
MIN_TEXT_LENGTH=400
# User agent string for HTTP requests
# CRAWLER_USER_AGENT=TTDS-SearchEngine-Crawler (academic; contact: s2795693@deu.ac.uk)

# Indexer Configuration
# Output directory (should point to indexer's input directory)
INDEXER_OUTPUT_DIR=../indexer/input
# Output filename for Indexer
INDEXER_OUTPUT_FILENAME=docs.json
# Whether to save content to the database (true/false)
# false saves only metadata, content is sent only to indexer to save database storage space
SAVE_CONTENT_TO_DB=false

# JSON flush mode (for handling large-scale incremental updates):
# CRITICAL: If your Indexer cannot correctly handle duplicate IDs (e.g., it merges/mixes
#           duplicate documents instead of using the latest), you MUST use "append" mode.
#
# - "append": Merge with existing file and dedup (DEFAULT, STRONGLY RECOMMENDED)
#             Ensures no duplicate IDs in JSON file. Safe for all Indexers.
#             Performance: Fast for small files, streaming for large files.
#
# - "overwrite": Replace entire file (for testing or full rebuild only)
#
# - "append_only": Fast append without dedup (DANGEROUS if Indexer can't handle duplicates)
#                  Only use if you run periodic dedup_file() before Indexer reads the file.
INDEXER_FLUSH_MODE=append

# File size threshold (MB) for dedup strategy selection
# Files smaller than this use in-memory dedup (fast)
# Files larger use streaming dedup (memory-efficient)
INDEXER_DEDUP_THRESHOLD_MB=100
